    "views": {
      "omp": [
        {
          "id": "omp.sessions",
          "name": "Sessions"
        },
        {
          "id": "omp.skills",
          "name": "Skills",
          "visibility": "collapsed"
        },
        {
          "id": "omp.tools",
          "name": "Tools",
          "visibility": "collapsed"
        },
        {
          "id": "omp.mcp",
          "name": "MCP",
          "visibility": "collapsed"
