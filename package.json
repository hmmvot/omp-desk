    },
    "viewsWelcome": [
      {
        "view": "omp.sessions",
        "when": "omp.catalogPending",
        "contents": "Reading this profile's stored OMP sessions and pinned folders…"
      },
      {
        "view": "omp.sessions",
        "when": "!omp.hasWorkspaceFolders && !omp.catalogPending && config.omp.showWorkspaceFolders && omp.sessionsLayout != terminals",
        "contents": "Open a folder in VS Code, or add one here. Open folders appear automatically; pinned folders stay in every window.\n[Add Folder](command:omp.addWorkspaceFolder)\n[New Session](command:omp.newSession)\nClick a session to view its history. Use the row's Open action to start or resume it."
      },
      {
        "view": "omp.sessions",
        "when": "!omp.hasWorkspaceFolders && !omp.catalogPending && !config.omp.showWorkspaceFolders && omp.sessionsLayout != terminals",
        "contents": "No folder is pinned. Open folders are hidden by the omp.showWorkspaceFolders setting.\n[Add Folder](command:omp.addWorkspaceFolder)\n[New Session](command:omp.newSession)\nClick a session to view its history. Use the row's Open action to start or resume it."
      },
      {
        "view": "omp.sessions",
        "when": "omp.sessionsLayout == terminals && omp.processesLoaded && !omp.catalogPending",
        "contents": "No OMP background process is running.\nA session or terminal keeps running in a background process after its editor or window closes. It is listed here until it exits or you stop it."
      }
    ],
