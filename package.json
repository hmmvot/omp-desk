{
  "name": "omp-desk",
  "displayName": "OMP Desk",
  "description": "Run Oh My Pi (omp) sessions in VS Code: a Sessions view, Chat or the native Terminal TUI in one editor, and sessions that survive reloads. Windows only.",
  "icon": "media/omp-icon.png",
  "version": "0.3.2",
  "publisher": "hmmvot",
  "author": {
    "name": "hmmvot"
  },
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hmmvot/omp-desk.git"
  },
  "bugs": {
    "url": "https://github.com/hmmvot/omp-desk/issues"
  },
  "homepage": "https://github.com/hmmvot/omp-desk#readme",
  "galleryBanner": {
    "color": "#0B0B18",
    "theme": "dark"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "ohmypi",
    "ai",
    "agent",
    "coding agent",
    "chat",
    "terminal",
    "tui",
    "sessions",
    "llm",
    "windows",
    "conpty"
  ],
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "OMP Desk starts the installed omp and PowerShell helpers with a workspace folder as the working directory, so it needs a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:omp.sessions",
    "onView:omp.skills",
    "onView:omp.tools",
    "onView:omp.mcp",
    "onView:omp.extensions",
    "onView:omp.context",
    "onView:omp.deskSettings",
    "onUri",
    "onWebviewPanel:omp.session",
    "onWebviewPanel:omp.shellTerminal",
    "onWebviewPanel:omp.settings"
  ],
  "contributes": {
    "configuration": {
      "title": "OMP Desk",
      "properties": {
        "omp.toolCallDetail": {
          "type": "string",
          "enum": ["overview", "detailed"],
          "default": "overview",
          "scope": "application",
          "description": "Tool presentation in every OMP Chat. Overview groups routine calls; Detailed shows individual calls. The Tools output picker in the chat footer changes this global setting live."
        },
        "omp.desktopNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show Windows desktop notifications when a session finishes or asks for input unless its editor is active and visible in the focused window. Display questions may remain in Windows notification history and appear on the lock screen."
        },
        "omp.showWorkspaceFolders": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show the folders VS Code has open in any window, or every folder of a multi-root workspace, in Sessions next to the pinned folders. The setting applies to all windows, so every window shows the same list. When off, Sessions shows only pinned folders and folders where a session is running."
        },
        "omp.useAgentRootFolder": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "When a folder VS Code has open has no agent files (AGENTS.md, CLAUDE.md, .agents, .omp, .claude, .pi) but sits inside a Git repository whose root, or a folder between, has them, Sessions shows that ancestor instead, so new sessions start where OMP finds the repository's agent files. Sessions recorded in the opened folder stay listed under it. The setting applies to all windows. When off, Sessions shows the opened folder."
        },
        "omp.launchInFolderWindow": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Start a session in the window that has its folder open. When you start a new session, resume one from a folder, or open a stopped session of a folder that VS Code has open only in another window, that window launches it and comes to the front with the session's tab. A folder open in this window, or in no window, starts here. A Unity project (a folder with ProjectSettings/ProjectVersion.txt and Assets, found in the folder or two levels below it) always runs in a window that has the project folder open, even when the repository is open here, or in a new window opened on it, because the Unity extensions need it; the session's working directory stays the repository folder. If that window does not answer, a message says so and nothing starts. When off, every launch starts in the window you used."
        },
        "omp.sessionsGrouping": {
          "type": "string",
          "enum": ["flat", "folders", "terminals"],
          "enumDescriptions": [
            "One list of every session, labelled with its folder: sessions that are not stopped first (unread first, then most recent activity), stopped sessions last, and a New Session row at the end.",
            "Sessions grouped under their folders.",
            "The background processes of this profile instead of sessions: session processes and terminals, each labelled with its folder. A row opens its session or terminal."
          ],
          "default": "flat",
          "description": "How Sessions arranges its rows. The layout button in the Sessions title bar opens a picker that changes this setting."
        },
        "omp.chatColumn": {
          "type": "boolean",
          "default": true,
          "description": "Open OMP session editors in their own editor group on the left and lock that group, so files and other tabs open in a group to the right and the chat stays visible. When off, a session editor opens in the active editor group."
        },
        "omp.linkCodeSymbols": {
          "type": "boolean",
          "default": true,
          "description": "Link inline code symbols in Chat replies (`Session`, `SessionData.Cast`, `Parse()`) to their definition when VS Code's language extensions (C# Dev Kit, TypeScript, ...) find exactly one definition of the symbol in the session's folders, and a bare file name such as `session-index.ts:849` to the file when VS Code's file search finds it in the session's folders (several files of that name link to a list to choose from). Ambiguous or unknown symbols stay plain code. When off, only the links the model writes itself and file paths are links."
        },
        "omp.linkReminder": {
          "type": "boolean",
          "default": false,
          "description": "Remind the model after every prompt you send to write the files and folders it mentions as paths in inline code and every code symbol in Chat replies as a link ([`Name`](path:line)). The reminder is a separate message added to the request only (about 120 tokens per prompt); it is never saved to the session or shown. Applies to sessions started or resumed afterwards."
        },
        "omp.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path of the OMP to run: the `omp` program itself, or a Bun-installed `omp.exe` shim. Empty uses the first `omp` on PATH. When set, this is the only OMP Desk considers: if it cannot be used, Desk says why and does not search PATH. Applies to sessions started, resumed or read afterwards. User settings only; a workspace cannot set it."
        },
        "omp.agentDebugger.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Give the agent of an OMP Chat session tools (`vscode_debug_*`) to drive VS Code's debugger: set breakpoints, start a launch configuration, wait for a stop, read the stack and variables, step, and hand the paused program to you. The agent works through VS Code's own debug sessions, so you see the same breakpoints and paused state in Run and Debug and can take over at any time. The tools are available in the main session of Chat editors only. These permissions are consent prompts, not a sandbox: a launch configuration can run programs and tasks, and the agent can also edit your workspace. Applies to sessions started or resumed afterwards."
        },
        "omp.agentDebugger.start": {
          "type": "string",
          "enum": ["ask", "allow"],
          "enumDescriptions": [
            "Ask before the agent starts a debug configuration; the prompt names the folder, the configuration or preset, its type and request, and its program.",
            "Start the debug configurations the agent chooses without asking."
          ],
          "default": "ask",
          "scope": "application",
          "description": "Whether the agent may start a debug configuration of your launch.json (or an Attach to Unity Editor preset) without asking. Only the agent's own starts can be controlled by it; sessions you started are read-only to the agent."
        },
        "omp.agentDebugger.expressions": {
          "type": "string",
          "enum": ["off", "ask", "allow"],
          "enumDescriptions": [
            "The agent may not run expressions in the debugged program: no evaluate, breakpoint conditions or log messages.",
            "Ask before each expression; the prompt shows the debug session and the exact expression.",
            "Run the expressions the agent chooses without asking."
          ],
          "default": "ask",
          "scope": "application",
          "description": "Whether the agent may run code in the debugged program: evaluating an expression, and breakpoint conditions and log messages (all of them run code in the debuggee)."
        }
      }
    },
    "configurationDefaults": {
      "terminal.integrated.commandsToSkipShell": [
        "omp.focusComposer",
        "omp.goToSession",
        "omp.moveFileToNewWindow"
      ]
    },
    "viewsContainers": {
